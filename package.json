{
  "name": "abyssal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:server\" \"npm:client\"",
    "server": "tsx watch server/index.ts",
    "client": "vite --host 0.0.0.0",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=build/server.mjs --log-level=warning --banner:js=\"import { createRequire as __abyssalRequire } from 'node:module'; const require = __abyssalRequire(import.meta.url);\"",
    "start": "node build/server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "bots": "tsx bots/record.ts"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.48",
    "@colyseus/sdk": "^0.18.10",
    "@colyseus/ws-transport": "^0.18.5",
    "colyseus": "^0.18.12",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "ultracite": "^8.2.1",
    "vite": "^8.3.8"
  }
}
