#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() {
  local start=$SECONDS
  echo "==> $*"
  "$@"
  echo "    done in $((SECONDS - start))s"
}

if [[ "$(node -p 'const [a, b] = process.versions.node.split(".").map(Number); a > 22 || (a === 22 && b >= 18)')" != true ]]; then
  echo "Node 22.18 or newer is required, found $(node -v)" >&2
  exit 1
fi

step npm install --no-save --no-audit --no-fund --prefer-offline
